[sub_resource type="GDScript" id="GDScript_akcju"]
script/source = "extends Area3D

@export var knock_power : float = 25
@export var damage : float = 25

func _process(_delta: float) -> void:
	for body in get_overlapping_bodies():
		if body.has_method(\"hurt\"):
			var knockback = (body.global_position - global_position).normalized()
			knockback = Vector3(knockback.x, knockback.y * 0.5, knockback.z)
			body.hurt(damage,knockback * knock_power)
"

